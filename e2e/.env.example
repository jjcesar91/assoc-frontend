# Copia in e2e/.env e compila (il file .env non va versionato)
E2E_BASE_URL=https://dev.etspoint.it
# Superuser dedicato ai test su dev
E2E_SUPERUSER_EMAIL=e2e.superuser@example.com
E2E_SUPERUSER_PASSWORD=
# Accesso SSH all'host di dev: link di attivazione e pulizia dei dati di prova
E2E_SSH=ssh -i ~/.ssh/assoc_deploy_ed25519 -p 1824 dave@dev.etspoint.it
